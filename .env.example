# Kosongkan VITE_API_URL untuk mode template lokal tanpa akun.
# Client dan API produksi perlu memakai domain induk yang sama untuk sesi cookie.
VITE_API_URL=
# Kunci rahasia hanya di server, tidak boleh memakai prefix VITE_.
DATABASE_URL=postgres://rancang:rancang_local@localhost:5432/rancang
ANTHROPIC_API_KEY=
# Isi ID model yang tersedia pada akun Anthropic.
ANTHROPIC_MODEL=
WEB_ORIGIN=http://127.0.0.1:5178
PORT=3001
NODE_ENV=development
DAILY_GENERATION_LIMIT=10

