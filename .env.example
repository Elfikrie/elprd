# Client lokal: kosongkan untuk template offline; same-origin untuk client/API satu domain.
VITE_API_URL=
# Untuk lokal; produksi pakai URI Transaction pooler Supabase (port 6543).
DATABASE_URL=postgres://rancang:rancang_local@localhost:5432/rancang
# Netlify AI Gateway menyuntikkan key/base URL saat runtime. Tidak boleh memakai prefix VITE_.
ANTHROPIC_API_KEY=
# Isi ID model yang tersedia dan sudah diverifikasi.
ANTHROPIC_MODEL=
WEB_ORIGIN=http://127.0.0.1:5178
PORT=3001
NODE_ENV=development
DAILY_GENERATION_LIMIT=10

